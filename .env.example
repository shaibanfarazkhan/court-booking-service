# Application Configuration
APP_NAME="Court Booking Service"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=court_booking_db
