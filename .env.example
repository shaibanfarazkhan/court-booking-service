# Application Configuration
APP_NAME="Court Booking Service"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=court_booking_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async Database URLs (used by SQLAlchemy 2.0 with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/court_booking_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/court_booking_test_db

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False
