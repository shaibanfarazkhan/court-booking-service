# Copy to .env and replace every placeholder before deployment.
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_PORT=8000

POSTGRES_USER=court_booking
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password
POSTGRES_DB=court_booking_db

# URL for the Compose network. Use `localhost` instead of `postgres` when
# running the API directly on your host machine.
DATABASE_URL=postgresql+asyncpg://court_booking:replace-with-a-unique-url-safe-password@postgres:5432/court_booking_db

# Generate a unique random value of at least 32 characters for each deployment.
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
